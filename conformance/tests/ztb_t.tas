# Ztb extension: CLZT.T (leading zero trits) / TCNT.T
# (non-zero trit count) (A1.6)
# Written to rebel6-extensions.md "Ztb - trit manipulation";
# expected values re-verified independently when the group landed.
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: clzt(0) = 24
	li.t a0, 1
	clzt.t t1, zero
	li.t t2, 24
	bne.t t1, t2, fail
	# check 2: clzt(1) = 23
	li.t a0, 2
	li.t t0, 1
	clzt.t t1, t0
	li.t t2, 23
	bne.t t1, t2, fail
	# check 3: clzt(-1) = 23 (leading-zero count ignores sign)
	li.t a0, 3
	li.t t0, -1
	clzt.t t1, t0
	bne.t t1, t2, fail
	# check 4: clzt(MAX) = 0 (top trit set)
	li.t a0, 4
	li.t t0, 141214768240
	clzt.t t1, t0
	bne.t t1, zero, fail
	# check 5: clzt(3^23) = 0
	li.t a0, 5
	li.t t0, 94143178827
	clzt.t t1, t0
	bne.t t1, zero, fail
	# check 6: clzt(3^22) = 1
	li.t a0, 6
	li.t t0, 31381059609
	clzt.t t1, t0
	li.t t2, 1
	bne.t t1, t2, fail
	# check 7: tcnt(0) = 0
	li.t a0, 7
	tcnt.t t1, zero
	bne.t t1, zero, fail
	# check 8: tcnt(5) = 3 (trits -,-,+)
	li.t a0, 8
	li.t t0, 5
	tcnt.t t1, t0
	li.t t2, 3
	bne.t t1, t2, fail
	# check 9: tcnt(9) = 1
	li.t a0, 9
	li.t t0, 9
	tcnt.t t1, t0
	li.t t2, 1
	bne.t t1, t2, fail
	# check 10: tcnt(MAX) = 24 (all trits +)
	li.t a0, 10
	li.t t0, 141214768240
	tcnt.t t1, t0
	li.t t2, 24
	bne.t t1, t2, fail
	# check 11: tcnt(MIN) = 24 (all trits -)
	li.t a0, 11
	li.t t0, -141214768240
	tcnt.t t1, t0
	bne.t t1, t2, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
