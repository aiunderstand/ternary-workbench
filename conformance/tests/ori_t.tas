# ORI.T conformance: tritwise max with imm12
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: full 9-pair vector: max(9464, 6056) = 9728
	li.t a0, 1
	li.t t0, 9464
	ori.t t1, t0, 6056
	li.t t2, 9728
	bne.t t1, t2, fail
	# check 2: ori(5, 7) = 7
	li.t a0, 2
	li.t t0, 5
	ori.t t1, t0, 7
	li.t t2, 7
	bne.t t1, t2, fail
	# check 3: ori(x, 0) is NOT identity - 0 is not the identity of max
	# 5 = (-,-,+): max with 0 zeroes the minus lanes -> (0,0,+) = 9
	li.t a0, 3
	ori.t t1, t0, 0
	li.t t2, 9
	bne.t t1, t2, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
