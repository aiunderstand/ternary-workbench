# LWA.T / SWA.T conformance: absolute word store/load (imm24 address)
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: positive round-trip
	li.t a0, 1
	li.t t0, 424242
	swa.t t0, buf
	lwa.t t1, buf
	bne.t t1, t0, fail
	# check 2: negative round-trip
	li.t a0, 2
	li.t t0, -99999
	swa.t t0, buf2
	lwa.t t1, buf2
	bne.t t1, t0, fail
	# check 3: the two addresses stayed independent
	li.t a0, 3
	lwa.t t1, buf
	li.t t2, 424242
	bne.t t1, t2, fail
	# check 4: agrees with register-indirect lw.t at the same address
	li.t a0, 4
	li.t s0, buf
	lw.t t1, s0, 0
	bne.t t1, t2, fail
	# check 5: MIN round-trip
	li.t a0, 5
	li.t t0, -141214768240
	swa.t t0, buf
	lwa.t t1, buf
	bne.t t1, t0, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t

	.data
buf:
	.zero 4
buf2:
	.zero 4
