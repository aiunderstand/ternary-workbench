# BNE.T conformance: taken and not-taken
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: not equal -> taken
	li.t a0, 1
	li.t t0, 5
	li.t t1, 6
	bne.t t0, t1, taken1
	jal.t zero, fail
taken1:
	# check 2: equal -> not taken
	li.t a0, 2
	bne.t t0, t0, fail
	# check 3: sign difference -> taken
	li.t a0, 3
	li.t t0, 7
	li.t t1, -7
	bne.t t0, t1, taken3
	jal.t zero, fail
taken3:
	# check 4: 0 == x0 -> not taken
	li.t a0, 4
	li.t t0, 0
	bne.t t0, zero, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
