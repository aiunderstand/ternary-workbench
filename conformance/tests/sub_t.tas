# SUB.T conformance: balanced subtract, wrap modulo 3^24
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: 3 - 5 = -2
	li.t a0, 1
	li.t t0, 3
	li.t t1, 5
	sub.t t2, t0, t1
	li.t t3, -2
	bne.t t2, t3, fail
	# check 2: 5 - 3 = 2
	li.t a0, 2
	sub.t t2, t1, t0
	li.t t3, 2
	bne.t t2, t3, fail
	# check 3: 0 - 5 = -5
	li.t a0, 3
	sub.t t2, zero, t1
	li.t t3, -5
	bne.t t2, t3, fail
	# check 4: MIN - 1 wraps to MAX
	li.t a0, 4
	li.t t0, -141214768240
	li.t t1, 1
	sub.t t2, t0, t1
	li.t t3, 141214768240
	bne.t t2, t3, fail
	# check 5: MAX - (-1) wraps to MIN
	li.t a0, 5
	li.t t0, 141214768240
	li.t t1, -1
	sub.t t2, t0, t1
	li.t t3, -141214768240
	bne.t t2, t3, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
