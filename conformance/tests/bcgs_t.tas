# BCGS.T conformance: three-way branch - greater -> off1,
# smaller -> off2, equal -> fall through (PC+1)
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: 2 > 1 -> first target
	li.t a0, 1
	li.t t0, 2
	li.t t1, 1
	bcgs.t t0, t1, arm_gt, fail
	jal.t zero, fail
arm_gt:
	# check 2: 1 < 2 -> second target
	li.t a0, 2
	bcgs.t t1, t0, fail, arm_lt
	jal.t zero, fail
arm_lt:
	# check 3: equal -> falls through past both targets
	li.t a0, 3
	bcgs.t t0, t0, fail, fail
	# check 4: numeric displacement +2 skips exactly one instruction
	li.t a0, 4
	bcgs.t t0, t1, 2, 2
	jal.t zero, fail
	# check 5: negative operands: -2 < -1 -> second target
	li.t a0, 5
	li.t t0, -2
	li.t t1, -1
	bcgs.t t0, t1, fail, arm_neg
	jal.t zero, fail
arm_neg:
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
