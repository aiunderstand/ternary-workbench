# SLTI.T conformance: set if less than immediate (+1 / 0)
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: 3 < 5 -> +1
	li.t a0, 1
	li.t t0, 3
	slti.t t1, t0, 5
	li.t t2, 1
	bne.t t1, t2, fail
	# check 2: 5 < 5 -> 0
	li.t a0, 2
	li.t t0, 5
	slti.t t1, t0, 5
	bne.t t1, zero, fail
	# check 3: 5 < 3 -> 0
	li.t a0, 3
	slti.t t1, t0, 3
	bne.t t1, zero, fail
	# check 4: -5 < -3 -> +1
	li.t a0, 4
	li.t t0, -5
	slti.t t1, t0, -3
	li.t t2, 1
	bne.t t1, t2, fail
	# check 5: 0 < -265720 -> 0 (imm12 minimum)
	li.t a0, 5
	slti.t t1, zero, -265720
	bne.t t1, zero, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
