# SRIN.T / SRIZ.T / SRIP.T conformance: immediate right shifts
# The fill trit lands in every vacated top trit.
# PROVISIONAL: pending the signed-shift-amount proposal (see README).
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	li.t t0, 9
	# check 1: 9 >> 2 fill 0 = 1
	li.t a0, 1
	sriz.t t1, t0, 2
	li.t t2, 1
	bne.t t1, t2, fail
	# check 2: 9 >> 2 fill - = 1 - 3^22 - 3^23 = -125524238435
	li.t a0, 2
	srin.t t1, t0, 2
	li.t t2, -125524238435
	bne.t t1, t2, fail
	# check 3: 9 >> 2 fill + = 1 + 3^22 + 3^23 = 125524238437
	li.t a0, 3
	srip.t t1, t0, 2
	li.t t2, 125524238437
	bne.t t1, t2, fail
	# check 4: 5 >> 1 fill 0 = 2 (lanes (-,-,+) -> (-,+))
	li.t a0, 4
	li.t t0, 5
	sriz.t t1, t0, 1
	li.t t2, 2
	bne.t t1, t2, fail
	# check 5: 5 >> 1 fill - = 2 - 3^23 = -94143178825
	li.t a0, 5
	srin.t t1, t0, 1
	li.t t2, -94143178825
	bne.t t1, t2, fail
	# check 6: 5 >> 1 fill + = 2 + 3^23 = 94143178829
	li.t a0, 6
	srip.t t1, t0, 1
	li.t t2, 94143178829
	bne.t t1, t2, fail
	# check 7: shift by 0 is identity for every fill
	li.t a0, 7
	li.t t0, -777
	srin.t t1, t0, 0
	bne.t t1, t0, fail
	srip.t t1, t0, 0
	bne.t t1, t0, fail
	sriz.t t1, t0, 0
	bne.t t1, t0, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
