# DEPRECATED-ALIAS coverage: old per-direction shift spellings.
# The signed-shift design (REBEL-toolchain/rebel6-signed-shifts-proposal.md,
# accepted 2026-08-09) collapsed SL*/SLI*/SR*/SRI* into SH<f>.T/SHI<f>.T;
# the simulator keeps the old spellings as deprecated aliases. This file
# only guards against alias regressions while they still exist -
# DELETE IT when the aliases are removed. Canonical coverage lives in
# shi_fills_t.tas and sh_reg_t.tas.
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: deprecated sliz.t 1 by 2 = 9 (alias of shiz.t +2)
	li.t a0, 1
	li.t t0, 1
	sliz.t t1, t0, 2
	li.t t2, 9
	bne.t t1, t2, fail
	# check 2: deprecated sriz.t 9 by 2 = 1 (alias of shiz.t -2)
	li.t a0, 2
	li.t t0, 9
	sriz.t t1, t0, 2
	li.t t2, 1
	bne.t t1, t2, fail
	# check 3: deprecated slz.t 1 by reg 3 = 27 (alias of shz.t)
	li.t a0, 3
	li.t t0, 1
	li.t t1, 3
	slz.t t2, t0, t1
	li.t t3, 27
	bne.t t2, t3, fail
	# check 4: deprecated srz.t 27 by reg 3 = 1 (alias negating the amount)
	li.t a0, 4
	li.t t0, 27
	srz.t t2, t0, t1
	li.t t3, 1
	bne.t t2, t3, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
