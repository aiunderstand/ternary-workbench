# Leading-underscore labels: the ABI mandates _start, __stack_top,
# __data_start, ... as symbol names, so the assembler dialect must accept
# a leading '_' anywhere a label operand is legal (A4 spike finding
# 2026-08-10: the executor's operand classifier only accepted [A-Za-z.]
# and unresolved '_' symbols crashed the displacement parser).
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	li.t s1, 0
	# check 1: jal.t to a leading-underscore code label
	li.t a0, 1
	jal.t ra, _bump
	li.t t0, 1
	bne.t s1, t0, fail
	# check 2: li.t of a __data label + word round-trip
	li.t a0, 2
	li.t t0, __data_word
	lw.t t1, t0, 0
	li.t t2, 730
	bne.t t1, t2, fail
	# check 3: branch to a leading-underscore label
	li.t a0, 3
	beq.t zero, zero, __takeit
	jal.t zero, fail
__takeit:
	# check 4: .word holding a __ label address (heap relocation path)
	li.t a0, 4
	li.t t0, __data_ptr
	lw.t t1, t0, 0
	li.t t2, __data_word
	bne.t t1, t2, fail
	# check 5: jalr.t through a register holding a _ label address
	li.t a0, 5
	li.t t0, _bump
	jalr.t ra, t0, 0
	li.t t1, 2
	bne.t s1, t1, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
_bump:
	addi.t s1, s1, 1
	jalr.t zero, ra, 0
fail:
	li.t a7, 93
	ecall.t

	.data
__data_word:
	.word 730
__data_ptr:
	.word __data_word
