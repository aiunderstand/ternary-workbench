# SLN.T / SLZ.T / SLP.T / SRN.T / SRZ.T / SRP.T conformance:
# register-amount shifts, one check per fill in each direction.
# PROVISIONAL: pending the signed-shift-amount proposal (see README).
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: slz 1 << 3 = 27
	li.t a0, 1
	li.t t0, 1
	li.t t1, 3
	slz.t t2, t0, t1
	li.t t3, 27
	bne.t t2, t3, fail
	# check 2: srz 27 >> 3 = 1
	li.t a0, 2
	li.t t0, 27
	srz.t t2, t0, t1
	li.t t3, 1
	bne.t t2, t3, fail
	# check 3: sln 1 << 1 = 3 - 1 = 2
	li.t a0, 3
	li.t t0, 1
	li.t t1, 1
	sln.t t2, t0, t1
	li.t t3, 2
	bne.t t2, t3, fail
	# check 4: slp 1 << 1 = 3 + 1 = 4
	li.t a0, 4
	slp.t t2, t0, t1
	li.t t3, 4
	bne.t t2, t3, fail
	# check 5: srn 3 >> 1 = 1 - 3^23 = -94143178826
	li.t a0, 5
	li.t t0, 3
	srn.t t2, t0, t1
	li.t t3, -94143178826
	bne.t t2, t3, fail
	# check 6: srp 3 >> 1 = 1 + 3^23 = 94143178828
	li.t a0, 6
	srp.t t2, t0, t1
	li.t t3, 94143178828
	bne.t t2, t3, fail
	# check 7: register amount 0 is identity for all six forms
	li.t a0, 7
	li.t t0, -777
	sln.t t2, t0, zero
	bne.t t2, t0, fail
	slz.t t2, t0, zero
	bne.t t2, t0, fail
	slp.t t2, t0, zero
	bne.t t2, t0, fail
	srn.t t2, t0, zero
	bne.t t2, t0, fail
	srz.t t2, t0, zero
	bne.t t2, t0, fail
	srp.t t2, t0, zero
	bne.t t2, t0, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
