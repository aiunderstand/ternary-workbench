# MAX.T conformance: wordwise maximum, and the min/max duality
# min(a, b) = -max(-a, -b) (their func codes are negatives of each other)
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: max(3, 5) = 5
	li.t a0, 1
	li.t t0, 3
	li.t t1, 5
	max.t t2, t0, t1
	bne.t t2, t1, fail
	# check 2: max(-5, 3) = 3
	li.t a0, 2
	li.t t0, -5
	li.t t1, 3
	max.t t2, t0, t1
	bne.t t2, t1, fail
	# check 3: duality with a=7, b=-2: min(a,b) == -max(-a,-b)
	li.t a0, 3
	li.t t0, 7
	li.t t1, -2
	min.t t2, t0, t1
	sti.t t3, t0
	sti.t t4, t1
	max.t t5, t3, t4
	sti.t t5, t5
	bne.t t2, t5, fail
	# check 4: duality with a=-5, b=-3
	li.t a0, 4
	li.t t0, -5
	li.t t1, -3
	min.t t2, t0, t1
	sti.t t3, t0
	sti.t t4, t1
	max.t t5, t3, t4
	sti.t t5, t5
	bne.t t2, t5, fail
	# check 5: max(MIN, MAX) = MAX
	li.t a0, 5
	li.t t0, -141214768240
	li.t t1, 141214768240
	max.t t2, t0, t1
	bne.t t2, t1, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
