# SHIN.T / SHIZ.T / SHIP.T conformance: signed immediate shifts
# (ratified signed-shift design, Option A - see
# REBEL-toolchain/rebel6-signed-shifts-proposal.md).
# k > 0 shifts toward the MST, k < 0 toward the LST, k = 0 identity,
# |k| >= 24 all-fill. Fill trit: N = -, Z = 0, P = +.
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	li.t t0, 1
	# check 1: shiz 1 by +2 = 9
	li.t a0, 1
	shiz.t t1, t0, 2
	li.t t2, 9
	bne.t t1, t2, fail
	# check 2: shin 1 by +2 = 9 - 3 - 1 = 5 (fill - in both vacated trits)
	li.t a0, 2
	shin.t t1, t0, 2
	li.t t2, 5
	bne.t t1, t2, fail
	# check 3: ship 1 by +2 = 9 + 3 + 1 = 13 (fill + in both vacated trits)
	li.t a0, 3
	ship.t t1, t0, 2
	li.t t2, 13
	bne.t t1, t2, fail
	# check 4: fill lands in every vacated trit toward the MST
	# shin 1 by +3 = 27 - 13 = 14 and ship 1 by +3 = 27 + 13 = 40
	li.t a0, 4
	shin.t t1, t0, 3
	li.t t2, 14
	bne.t t1, t2, fail
	ship.t t1, t0, 3
	li.t t2, 40
	bne.t t1, t2, fail
	# check 5: shiz 9 by -2 = 1 (negative amount = toward the LST)
	li.t a0, 5
	li.t t0, 9
	shiz.t t1, t0, -2
	li.t t2, 1
	bne.t t1, t2, fail
	# check 6: shin 9 by -2 = 1 - 3^22 - 3^23 (fill - in both vacated top trits)
	li.t a0, 6
	shin.t t1, t0, -2
	li.t t2, -125524238435
	bne.t t1, t2, fail
	# check 7: ship 9 by -2 = 1 + 3^22 + 3^23 (fill + in both vacated top trits)
	li.t a0, 7
	ship.t t1, t0, -2
	li.t t2, 125524238437
	bne.t t1, t2, fail
	# check 8: nonzero lanes move down intact, fill lands in the one vacated top trit
	# 5 = lanes (-,-,+): shiz 5 by -1 = 2, shin adds -3^23, ship adds +3^23
	li.t a0, 8
	li.t t0, 5
	shiz.t t1, t0, -1
	li.t t2, 2
	bne.t t1, t2, fail
	shin.t t1, t0, -1
	li.t t2, -94143178825
	bne.t t1, t2, fail
	ship.t t1, t0, -1
	li.t t2, 94143178829
	bne.t t1, t2, fail
	# check 9: k = 0 is the identity for every fill
	li.t a0, 9
	li.t t0, -777
	shin.t t1, t0, 0
	bne.t t1, t0, fail
	shiz.t t1, t0, 0
	bne.t t1, t0, fail
	ship.t t1, t0, 0
	bne.t t1, t0, fail
	# check 10: k = +24 is all-fill (0, all-minus, all-plus)
	li.t a0, 10
	li.t t0, 123456
	shiz.t t1, t0, 24
	bne.t t1, zero, fail
	shin.t t1, t0, 24
	li.t t2, -141214768240
	bne.t t1, t2, fail
	ship.t t1, t0, 24
	li.t t2, 141214768240
	bne.t t1, t2, fail
	# check 11: k = -24 is all-fill too
	li.t a0, 11
	shiz.t t1, t0, -24
	bne.t t1, zero, fail
	shin.t t1, t0, -24
	li.t t2, -141214768240
	bne.t t1, t2, fail
	ship.t t1, t0, -24
	li.t t2, 141214768240
	bne.t t1, t2, fail
	# check 12: over-range amounts +-30 (within the +-40 shamt field) stay all-fill
	li.t a0, 12
	shiz.t t1, t0, 30
	bne.t t1, zero, fail
	shiz.t t1, t0, -30
	bne.t t1, zero, fail
	shin.t t1, t0, -30
	li.t t2, -141214768240
	bne.t t1, t2, fail
	ship.t t1, t0, 30
	li.t t2, 141214768240
	bne.t t1, t2, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
