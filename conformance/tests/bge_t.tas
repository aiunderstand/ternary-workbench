# BGE.T conformance: taken (> and ==), not taken (<)
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: 5 >= 3 -> taken
	li.t a0, 1
	li.t t0, 5
	li.t t1, 3
	bge.t t0, t1, taken1
	jal.t zero, fail
taken1:
	# check 2: 5 >= 5 -> taken
	li.t a0, 2
	bge.t t0, t0, taken2
	jal.t zero, fail
taken2:
	# check 3: 3 >= 5 -> not taken
	li.t a0, 3
	bge.t t1, t0, fail
	# check 4: -5 >= 3 -> not taken (signed value compare)
	li.t a0, 4
	li.t t0, -5
	li.t t1, 3
	bge.t t0, t1, fail
	# check 5: MAX >= MIN -> taken
	li.t a0, 5
	li.t t0, 141214768240
	li.t t1, -141214768240
	bge.t t0, t1, taken5
	jal.t zero, fail
taken5:
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
