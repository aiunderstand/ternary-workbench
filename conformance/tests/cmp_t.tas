# CMP.T conformance: three-way compare writes +1, 0, or -1
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: 5 > 3 -> +1
	li.t a0, 1
	li.t t0, 5
	li.t t1, 3
	cmp.t t2, t0, t1
	li.t t3, 1
	bne.t t2, t3, fail
	# check 2: 3 < 5 -> -1
	li.t a0, 2
	cmp.t t2, t1, t0
	li.t t3, -1
	bne.t t2, t3, fail
	# check 3: 5 == 5 -> 0
	li.t a0, 3
	cmp.t t2, t0, t0
	bne.t t2, zero, fail
	# check 4: -5 < -3 -> -1
	li.t a0, 4
	li.t t0, -5
	li.t t1, -3
	cmp.t t2, t0, t1
	li.t t3, -1
	bne.t t2, t3, fail
	# check 5: MIN < MAX -> -1
	li.t a0, 5
	li.t t0, -141214768240
	li.t t1, 141214768240
	cmp.t t2, t0, t1
	li.t t3, -1
	bne.t t2, t3, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
