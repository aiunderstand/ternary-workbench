# FENCE.T / WFI.T conformance: both execute and neither disturbs
# architectural state. FENCE.T orders nothing observable single-hart.
# WFI.T stalls until an interrupt is pending AND individually enabled
# (mip AND mie != 0) regardless of the global MIE (rebel6-platform.md
# "WFI.T"), so the test arms the CLINT timer in mie as its wake source;
# with global MIE = 0 the pending '+2' is never delivered and execution
# falls through to PC+1 - portable across implementations that stall
# and implementations that treat WFI.T as a NOP-with-hint.
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	li.t s0, buf
	li.t t0, 777
	sw.t s0, t0, 0
	li.t t1, -42
	# check 1: fence.t executes and registers/memory survive
	li.t a0, 1
	fence.t
	li.t t2, 777
	bne.t t0, t2, fail
	lw.t t3, s0, 0
	bne.t t3, t2, fail
	# check 2: wfi.t executes and registers/memory survive (timer armed in mie
	# as the wake source; global MIE stays 0 so no trap is taken)
	li.t a0, 2
	li.t t6, 9
	add.t mie, t6, zero
	wfi.t
	li.t t2, -42
	bne.t t1, t2, fail
	lw.t t3, s0, 0
	li.t t2, 777
	bne.t t3, t2, fail
	# check 3: back-to-back fences are fine
	li.t a0, 3
	fence.t
	fence.t
	bne.t t0, t2, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t

	.data
buf:
	.zero 4
