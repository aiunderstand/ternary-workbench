# ROTR.T conformance: register-amount cyclic shift, signed mod 24,
# no fill (ratified signed-shift design, ROTR.T in the freed R-ALU
# slot - see REBEL-toolchain/rebel6-signed-shifts-proposal.md).
# Pass: exit 0. Fail: exit a0 = index of failed check.
	.text
main:
	# check 1: rotr by reg +5 agrees with rot.t by immediate +5
	li.t a0, 1
	li.t t0, 123456
	li.t t1, 5
	rotr.t t2, t0, t1
	rot.t t3, t0, 5
	bne.t t2, t3, fail
	# check 2: rotr by reg -7 agrees with rot.t by immediate -7
	li.t a0, 2
	li.t t1, -7
	rotr.t t2, t0, t1
	rot.t t3, t0, -7
	bne.t t2, t3, fail
	# check 3: rotr(k) then rotr(-k) is the identity (k = 3)
	li.t a0, 3
	li.t t1, 3
	rotr.t t2, t0, t1
	li.t t1, -3
	rotr.t t2, t2, t1
	bne.t t2, t0, fail
	# check 4: rotr by reg 24 (mod 24 -> 0) is the identity
	li.t a0, 4
	li.t t1, 24
	rotr.t t2, t0, t1
	bne.t t2, t0, fail
	# check 5: directed wraparound - rotr(1, +1) = 3 toward the MST,
	# rotr(1, -1) wraps the LST to the MST: 3^23
	li.t a0, 5
	li.t t0, 1
	li.t t1, 1
	rotr.t t2, t0, t1
	li.t t3, 3
	bne.t t2, t3, fail
	li.t t1, -1
	rotr.t t2, t0, t1
	li.t t3, 94143178827
	bne.t t2, t3, fail
	# all checks passed
	li.t a7, 93
	li.t a0, 0
	ecall.t
fail:
	li.t a7, 93
	ecall.t
